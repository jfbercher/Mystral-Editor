{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mystral Editor",
  "version": "0.8.8",
  "identifier": "jfb",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVENjRGREEyRjAyNjlCNDYKUldSR215YndvdjFrWFdYL3R4QnFxNmkrNnNNSWgxVjN0TGVNSktRVnJLNXdWMXREMjl4QW9xMEYK",
      "endpoints": [
        "https://github.com/jfbercher/Mystral-Editor/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "Mystral Editor",
        "width": 1200,
        "height": 800,
        "preventOverflow": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,  
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "myst", "markdown", "txt"],
        "name": "Markdown Document",
        "role": "Editor"
      }
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
	"macOS": {
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    }
  }
}
